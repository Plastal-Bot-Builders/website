# Used automatically by `npm run build` (Create React App).
# Point this at the deployed backend. After the first Render deploy, confirm
# the service URL in the Render dashboard and update if it differs.
REACT_APP_API_BASE=https://plastalbot-backend-5lf9.onrender.com/api

# Public origin of the deployed site — used for canonical URLs, structured data,
# Open Graph/Twitter tags and the generated sitemap. Changing this one value
# updates all of them. No trailing slash.
REACT_APP_SITE_URL=https://plastalbotbuilders.com
