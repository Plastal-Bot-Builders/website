        {
          "@type": "FAQPage",
          "@id": "https://www.plastalbotbuilders.com/robocore#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is RoboCore?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "RoboCore is a robot kit and coding app for young makers, made in Zambia by Plastal-Bot Builders. Students build the robot, then code it with drag-and-drop blocks or Arduino C++."
              }
            },
            {
              "@type": "Question",
              "name": "Can I try RoboCore without a robot?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. The coding app includes a simulated preview board for exploring programs without physical hardware. Open the browser app in Chrome or Edge on a computer."
              }
            },
            {
              "@type": "Question",
              "name": "Where is RoboCore made?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "RoboCore is made in Zambia by Plastal-Bot Builders. It is currently a prototype, with school and innovation-hub pilots planned next."
              }
            },
            {
              "@type": "Question",
              "name": "Can I buy RoboCore?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Not yet. RoboCore V2 is a prototype. Pilots with schools and innovation hubs in Zambia come next."
              }
            },
            {
              "@type": "Question",
              "name": "How do you program RoboCore?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Use the RoboCore IDE on macOS, Windows or Linux, or in Chrome or Edge on a computer. Start with blocks or write Arduino C++. The blocks show the C++ they create."
              }
            }
          ]
        }
      ]
    },
    "faq": [
      {
        "q": "What is RoboCore?",
        "a": "RoboCore is a robot kit and coding app for young makers, made in Zambia by Plastal-Bot Builders. Students build the robot, then code it with drag-and-drop blocks or Arduino C++."
      },
      {
        "q": "Can I try RoboCore without a robot?",
        "a": "Yes. The coding app includes a simulated preview board for exploring programs without physical hardware. Open the browser app in Chrome or Edge on a computer."
      },
      {
        "q": "Where is RoboCore made?",
        "a": "RoboCore is made in Zambia by Plastal-Bot Builders. It is currently a prototype, with school and innovation-hub pilots planned next."
      },
      {
        "q": "Can I buy RoboCore?",
        "a": "Not yet. RoboCore V2 is a prototype. Pilots with schools and innovation hubs in Zambia come next."
      },
      {
        "q": "How do you program RoboCore?",
        "a": "Use the RoboCore IDE on macOS, Windows or Linux, or in Chrome or Edge on a computer. Start with blocks or write Arduino C++. The blocks show the C++ they create."
      }
    ]
