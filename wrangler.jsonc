{
  // Cloudflare Workers static-assets deployment.
  //
  // This project is a Create React App build (a folder of static files), not a
  // server. There is deliberately no "main" entry point: an assets-only Worker
  // just serves ./build from Cloudflare's edge.
  //
  // "not_found_handling": "single-page-application" makes any unmatched path
  // serve index.html so the React Router routes work on a hard refresh. Paths
  // that DO have a prerendered file (build/journey-to-geneva/index.html, etc.)
  // are served from disk, which is what keeps the per-page metadata and JSON-LD
  // visible to crawlers — see scripts/prerender.js.
  //
  // _headers in build/ is honoured here (CSP, HSTS, caching).
  //
  // There is deliberately NO _redirects file: on Workers, a "/* /index.html 200"
  // catch-all is rejected as an infinite loop (the asset server strips `/index`
  // and `.html`, so the rewrite target re-enters the same rule). SPA routing is
  // handled by not_found_handling above instead. If this project is ever moved
  // to Cloudflare Pages, that file has to come back — Pages has no equivalent
  // setting and relies on the catch-all.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-07-01",
  // "html_handling": "drop-trailing-slash" serves build/<route>/index.html at
  // /<route> directly. The default ("auto-trailing-slash") instead answers
  // /journey-to-geneva with a 307 to /journey-to-geneva/, which contradicts the
  // canonical URLs prerender.js writes (they have no trailing slash) and costs
  // every crawler an extra round trip per page.
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash"
  }
}
